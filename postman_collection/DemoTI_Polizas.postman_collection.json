{
  "info": {
    "name": "Demo TI - API de Gestion de Polizas",
    "description": "Colección para probar los endpoints en orden. Ejecutar de arriba hacia abajo con datos semilla recién creados (docker compose down -v && docker compose up --build -d). Cada petición lleva su test de código HTTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth (x-api-key)",
      "description": "Las tres primeras comprueban el filtro de seguridad; el resto de la colección envía x-api-key: {{apiKey}}.",
      "item": [
        {
          "name": "1. Auth - sin API key (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/polizas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "polizas"
              ]
            },
            "description": "Sin el header x-api-key la API responde 401 con ProblemDetail."
          },
          "response": []
        },
        {
          "name": "2. Auth - API key incorrecta (401)",
          "event": [
            {
              "listen": "test",
              "script": {
